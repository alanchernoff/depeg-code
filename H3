## =============================================================================
## HYPOTHESIS 3: Did reserve-transparency drive contagion during the USDC/SVB
##               depeg (March 2023)? DAI (heavy, disclosed USDC exposure via
##               its Peg Stability Module) should have depegged in tandem with
##               USDC, while USDT (opaque, non-SVB-exposed reserves) should
##               show a smaller, more muted reaction. BUSD is included as a
##               placebo -- its concurrent decline was driven by the separate,
##               unrelated NYDFS wind-down order, NOT by SVB, so it should show
##               no abnormal co-movement timed to the SVB news.
##
## Event timeline: SVB failure announced/closed 2023-03-10; USDC confirmed
## ~$3.3B exposure same day; Circle/USDC depegged sharply through 2023-03-11;
## US Treasury/FDIC backstop announced 2023-03-12, USDC re-pegged by 2023-03-13.
##
## Output: hypothesis3_SVB_USDC_contagion_results.docx
##   - Data coverage table
##   - Time-series plot of USDC / DAI / USDT / BUSD around the event window
##   - Peak deviation & time-to-recovery table per coin
##   - Difference-in-differences regression: deviation ~ Event * Coin
##     (Newey-West / HAC robust standard errors, USDT as reference category)
## =============================================================================

## ---- 0. Packages -------------------------------------------------------------
required_pkgs <- c("tidyverse", "lubridate", "officer", "flextable",
                    "zoo", "scales", "sandwich", "lmtest")
new_pkgs <- required_pkgs[!(required_pkgs %in% installed.packages()[, "Package"])]
if (length(new_pkgs)) install.packages(new_pkgs)

library(tidyverse)
library(lubridate)
library(officer)
library(flextable)
library(zoo)
library(scales)
library(sandwich)
library(lmtest)

## ---- 1. Setup -----------------------------------------------------------------
setwd("C:/Users/acher/research/")

DATA_FILE <- "stablecoin_hourly_prices_wide.csv"
OUT_DOCX  <- "hypothesis3_SVB_USDC_contagion_results.docx"

COINS <- c("USDC", "DAI", "USDT", "BUSD")

SVB_FAILURE   <- ymd_hms("2023-03-10 00:00:00", tz = "UTC")
TREASURY_BACKSTOP <- ymd_hms("2023-03-12 18:00:00", tz = "UTC")

PRE_WINDOW    <- c(SVB_FAILURE - days(14), SVB_FAILURE - hours(1))     # 2 wks pre
EVENT_WINDOW  <- c(SVB_FAILURE, TREASURY_BACKSTOP + hours(6))          # acute depeg window
POST_WINDOW   <- c(TREASURY_BACKSTOP + hours(6) + hours(1), SVB_FAILURE + days(14)) # 2 wks post
PLOT_WINDOW   <- c(SVB_FAILURE - days(14), SVB_FAILURE + days(14))

# Note: BUSD's data series ends 2023-03-13 15:00 UTC (NYDFS wind-down), so its
# post-window coverage will be truncated -- this is expected and noted in output.

## ---- 2. Load and reshape ------------------------------------------------------
raw <- read_csv(DATA_FILE, show_col_types = FALSE)

df <- raw %>%
  mutate(datetime_utc = ymd_hms(datetime_utc, tz = "UTC")) %>%
  pivot_longer(cols = -datetime_utc, names_to = "coin", values_to = "price") %>%
  filter(!is.na(price)) %>%
  mutate(deviation_bps = (price - 1) * 10000)

## ---- 3. Coverage table ---------------------------------------------------------
coverage_tbl <- df %>%
  filter(coin %in% COINS) %>%
  group_by(coin) %>%
  summarise(
    first_obs = min(datetime_utc),
    last_obs  = max(datetime_utc),
    n_in_plot_window = sum(datetime_utc >= PLOT_WINDOW[1] & datetime_utc <= PLOT_WINDOW[2]),
    n_in_post_window = sum(datetime_utc >= POST_WINDOW[1] & datetime_utc <= POST_WINDOW[2]),
    .groups = "drop"
  )

print(coverage_tbl)

## ---- 4. Event panel with phase + event dummy -----------------------------------
event_panel <- df %>%
  filter(coin %in% COINS, datetime_utc >= PLOT_WINDOW[1], datetime_utc <= PLOT_WINDOW[2]) %>%
  mutate(
    phase = case_when(
      datetime_utc >= PRE_WINDOW[1]   & datetime_utc <= PRE_WINDOW[2]   ~ "Pre-event",
      datetime_utc >= EVENT_WINDOW[1] & datetime_utc <= EVENT_WINDOW[2] ~ "Event window",
      datetime_utc >= POST_WINDOW[1]  & datetime_utc <= POST_WINDOW[2]  ~ "Post-event",
      TRUE ~ NA_character_
    ),
    event_dummy = if_else(phase == "Event window", 1L, 0L)
  ) %>%
  filter(!is.na(phase))

## ---- 5. Peak deviation & recovery time per coin --------------------------------
recovery_tbl <- map_dfr(COINS, function(cn) {
  sub <- event_panel %>% filter(coin == cn, phase %in% c("Event window", "Post-event")) %>%
    arrange(datetime_utc)
  if (nrow(sub) == 0) {
    return(tibble(coin = cn, peak_abs_dev_bps = NA_real_, peak_time = as.POSIXct(NA),
                   hours_to_recover = NA_real_, note = "No data in window"))
  }
  peak_idx  <- which.max(abs(sub$deviation_bps))
  peak_dev  <- sub$deviation_bps[peak_idx]
  peak_time <- sub$datetime_utc[peak_idx]

  # Recovery = first timestamp after the peak where |deviation| <= 10 bps
  after_peak <- sub %>% filter(datetime_utc > peak_time)
  recovered  <- after_peak %>% filter(abs(deviation_bps) <= 10)
  if (nrow(recovered) > 0) {
    hrs <- as.numeric(difftime(recovered$datetime_utc[1], peak_time, units = "hours"))
    note <- "Recovered within observed window"
  } else {
    hrs <- NA_real_
    note <- "Not yet recovered within observed window (data may end first, e.g. BUSD)"
  }
  tibble(coin = cn, peak_abs_dev_bps = round(peak_dev, 2), peak_time = peak_time,
         hours_to_recover = round(hrs, 1), note = note)
})

print(recovery_tbl)

## ---- 6. Difference-in-differences regression -----------------------------------
# deviation_bps ~ event_dummy * coin, USDT as reference (least SVB-exposed)
# Restrict to Pre-event and Event window only for a clean DiD comparison.
did_data <- event_panel %>%
  filter(phase %in% c("Pre-event", "Event window")) %>%
  mutate(coin = relevel(factor(coin), ref = "USDT"))

did_model <- lm(deviation_bps ~ event_dummy * coin, data = did_data)
hac_se <- coeftest(did_model, vcov = NeweyWest(did_model, lag = 24, prewhite = FALSE))

did_results <- tibble(
  term = rownames(hac_se),
  estimate = round(hac_se[, "Estimate"], 3),
  std_error_HAC = round(hac_se[, "Std. Error"], 3),
  p_value = round(hac_se[, "Pr(>|t|)"], 4)
)

print(did_results)

## ---- 7. Plots -------------------------------------------------------------------
plot_df <- event_panel %>% mutate(coin = factor(coin, levels = COINS))

p_event <- ggplot(plot_df, aes(x = datetime_utc, y = deviation_bps, color = coin)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "grey50") +
  annotate("rect", xmin = EVENT_WINDOW[1], xmax = EVENT_WINDOW[2],
           ymin = -Inf, ymax = Inf, alpha = 0.08, fill = "firebrick") +
  geom_line(linewidth = 0.4) +
  labs(
    title = "Peg Deviation Around the SVB / USDC Depeg (March 2023)",
    subtitle = "Shaded band = acute event window (SVB failure to Treasury backstop + 6h)",
    x = NULL, y = "Deviation from $1.00 (bps)", color = NULL
  ) +
  scale_color_manual(values = c(USDC = "#2b6cb0", DAI = "#dd6b20", USDT = "#38a169", BUSD = "#805ad5")) +
  scale_x_datetime(date_breaks = "3 days", labels = date_format("%b %d")) +
  theme_minimal(base_size = 10) +
  theme(legend.position = "top")

peak_plot_df <- recovery_tbl %>% filter(!is.na(peak_abs_dev_bps)) %>%
  mutate(coin = factor(coin, levels = COINS))

p_peak <- ggplot(peak_plot_df, aes(x = coin, y = peak_abs_dev_bps, fill = coin)) +
  geom_col(width = 0.6, show.legend = FALSE) +
  labs(
    title = "Peak Absolute Deviation During/After the SVB Event",
    x = NULL, y = "Peak |deviation| (bps)"
  ) +
  scale_fill_manual(values = c(USDC = "#2b6cb0", DAI = "#dd6b20", USDT = "#38a169", BUSD = "#805ad5")) +
  theme_minimal(base_size = 11)

## ---- 8. Assemble Word document ---------------------------------------------------
ft_coverage <- coverage_tbl %>%
  mutate(first_obs = format(first_obs, "%Y-%m-%d %H:%M"),
         last_obs  = format(last_obs, "%Y-%m-%d %H:%M")) %>%
  rename(Coin = coin, `First obs.` = first_obs, `Last obs.` = last_obs,
         `Obs. in plot window` = n_in_plot_window, `Obs. in post window` = n_in_post_window) %>%
  flextable() %>% autofit() %>% theme_vanilla()

ft_recovery <- recovery_tbl %>%
  mutate(peak_time = format(peak_time, "%Y-%m-%d %H:%M")) %>%
  rename(Coin = coin, `Peak |dev| (bps)` = peak_abs_dev_bps, `Peak time (UTC)` = peak_time,
         `Hours to recover (<=10bps)` = hours_to_recover, Note = note) %>%
  flextable() %>% autofit() %>% theme_vanilla() %>%
  fontsize(size = 9, part = "all")

ft_did <- did_results %>%
  rename(Term = term, Estimate = estimate, `HAC Std. Error` = std_error_HAC, `p-value` = p_value) %>%
  flextable() %>% autofit() %>% theme_vanilla() %>%
  fontsize(size = 8, part = "all")

doc <- read_docx() %>%
  body_add_par("Hypothesis 3: Reserve Transparency and Contagion in the SVB/USDC Depeg", style = "heading 1") %>%
  body_add_par(paste0("Generated ", format(Sys.time(), "%Y-%m-%d %H:%M %Z")), style = "Normal") %>%
  body_add_par("", style = "Normal") %>%
  body_add_par(
    paste0(
      "Hypothesis: During USDC's March 2023 depeg (triggered by Silicon Valley Bank's failure), ",
      "DAI -- which held substantial, disclosed USDC reserves via its Peg Stability Module -- ",
      "depegged in closer tandem with USDC than USDT did, whose reserve composition was opaque ",
      "and not directly SVB-exposed. Reserve transparency is therefore treated as a contagion ",
      "channel in its own right. BUSD is included as a placebo: its concurrent price/liquidity ",
      "stress stemmed from the separate NYDFS wind-down order, not from SVB, so it should NOT ",
      "show abnormal co-movement timed specifically to the SVB news."
    ), style = "Normal"
  ) %>%
  body_add_par("", style = "Normal") %>%
  body_add_par("1. Data Coverage", style = "heading 2") %>%
  body_add_flextable(ft_coverage) %>%
  body_add_par(
    "Note: BUSD's series ends 2023-03-13 15:00 UTC due to the unrelated NYDFS action, truncating its post-event window.",
    style = "Normal"
  ) %>%
  body_add_par("", style = "Normal") %>%
  body_add_par("2. Peg Deviation Around the Event Window", style = "heading 2") %>%
  body_add_gg(p_event, width = 6.5, height = 4.2) %>%
  body_add_par("", style = "Normal") %>%
  body_add_par("3. Peak Deviation and Recovery Time", style = "heading 2") %>%
  body_add_gg(p_peak, width = 6.5, height = 3.5) %>%
  body_add_flextable(ft_recovery) %>%
  body_add_par("", style = "Normal") %>%
  body_add_par("4. Difference-in-Differences Regression", style = "heading 2") %>%
  body_add_par(
    "Model: deviation_bps ~ event_dummy * coin, USDT as reference category. HAC (Newey-West, 24-lag) standard errors.",
    style = "Normal"
  ) %>%
  body_add_flextable(ft_did) %>%
  body_add_par("", style = "Normal") %>%
  body_add_par("5. Interpretation Notes", style = "heading 2") %>%
  body_add_par(
    paste0(
      "The coefficients on event_dummy:coinDAI and event_dummy:coinUSDC (relative to USDT) capture ",
      "the differential contagion effect. A significantly positive, larger coefficient for DAI than ",
      "for BUSD would support the transparency-channel hypothesis; a non-significant or negative ",
      "coefficient for BUSD supports its use as a placebo. Interpret BUSD's post-event results with ",
      "caution given its truncated data window."
    ), style = "Normal"
  )

print(doc, target = OUT_DOCX)
cat("Document written to:", file.path(getwd(), OUT_DOCX), "\n")
